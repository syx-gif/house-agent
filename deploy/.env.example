# ===== 复制本文件为 .env 后填写：cp .env.example .env =====

# --- LangGraph 自托管必需 ---
# 镜像名：先在本机/服务器执行 `langgraph build -t my-langgraph-agent`，再填这里
IMAGE_NAME=my-langgraph-agent

# LangSmith API Key（免费 Self-Hosted Lite 也需要，用于启动时一次性鉴权）
# 注册 https://smith.langchain.com 后免费获取
LANGSMITH_API_KEY=lsv2_xxxxxxxxxxxxxxxxxxxxxxxx

# --- LangGraph 内部 Postgres 密码（agent 状态库，可随意） ---
POSTGRES_PASSWORD=postgres

# --- 你的房源 MySQL（get_conn() 读这些变量）---
# 部署时 DB_HOST 填 compose 里的服务名 "mysql"
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=house_prd

# --- 智谱 GLM（llm.py 读这些变量）---
ZHIPUAI_API_KEY=your_zhipu_key
MODEL_NAME=glm-4.7
MODEL_TEMPERATURE=0
